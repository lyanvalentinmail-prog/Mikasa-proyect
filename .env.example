# ==========================================
# MIKASA SUB-BOT BUILDER PLATFORM - ENV
# ==========================================

# Server Ports
PORT=4000
API_PORT=4000
WEB_PORT=3000

# Environment Mode (development / production)
NODE_ENV=development

# JWT Secret for User Authentication
JWT_SECRET=mikasa-super-secret-jwt-key-change-in-production-2026
JWT_EXPIRES_IN=7d

# Database Configuration
# Default: SQLite file:./mikasa.db (Zero-config out of the box)
# Production PostgreSQL example: postgresql://postgres:password@localhost:5432/mikasa?schema=public
DATABASE_URL=file:./mikasa.db
SQLITE_DB_PATH=../../mikasa.db

# Optional Redis Cache & Message Queue
# REDIS_URL=redis://localhost:6379

# Media Storage (local / s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Optional AI Providers (Fallback smart simulator is active when omitted)
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=AIzaSy...

# CORS Allowed Origins
ALLOWED_ORIGINS=*
